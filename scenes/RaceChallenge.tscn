[gd_scene load_steps=3 format=3 uid="uid://racechallenge_scene"]

[ext_resource type="Script" path="res://scripts/race_manager.gd" id="1"]

[sub_resource type="BoxShape3D" id="gate_shape"]
size = Vector3(30, 5, 2)

[sub_resource type="StandardMaterial3D" id="start_mat"]
albedo_color = Color(0.1, 0.8, 0.1, 0.5)
transparency = 1

[sub_resource type="StandardMaterial3D" id="finish_mat"]
