[sub_resource type="BoxMesh" id="gate_vis_mesh"]
size = Vector3(30, 5, 0.3)

; ── Scene root with RaceManager script ───────────────────────────────────────
[node name="RaceChallenge" type="Node3D"]
script = ExtResource("1")
challenge_id = "mountain_run_01"
countdown_secs = 3

; ── Start gate (top of slope, before the main run) ────────────────────────────
[node name="StartGate" type="Area3D" parent="."]
