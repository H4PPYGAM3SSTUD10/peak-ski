# Normalize line endings for text files on all platforms
* text=auto

# Binary assets — never try to diff or merge these
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.ogg  binary
*.wav  binary
*.mp3  binary
*.res  binary
*.scn  binary
*.import filter=lfs diff=lfs merge=lfs -text
